rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 4.1: Global Safety Net - default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isBoundedStringList(arr, maxLen) {
      return arr is list && arr.size() <= maxLen && (arr.size() == 0 || (arr[0] is string && arr[0].size() <= 300));
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             data.xp is int && data.xp >= 0 && data.xp <= 10000000 &&
             data.streakDays is int && data.streakDays >= 0 && data.streakDays <= 10000 &&
             data.hearts is int && data.hearts >= 0 && data.hearts <= 5 &&
             data.gems is int && data.gems >= 0 && data.gems <= 1000000 &&
             data.totalExamsCompleted is int && data.totalExamsCompleted >= 0 && data.totalExamsCompleted <= 100000 &&
             data.totalRemedialsCompleted is int && data.totalRemedialsCompleted >= 0 && data.totalRemedialsCompleted <= 100000 &&
             isBoundedStringList(data.weakSubtopics, 30) &&
             isBoundedStringList(data.masteredUnits, 100) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidExamAttempt(data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128 &&
             data.subjectId is string && data.subjectId.size() >= 1 && data.subjectId.size() <= 64 &&
             data.subjectName is string && data.subjectName.size() >= 1 && data.subjectName.size() <= 100 &&
             data.mode is string && (data.mode == 'SIMULASI_TKA' || data.mode == 'UNIT_PATH' || data.mode == 'REMEDIAL_DRILL') &&
             data.irtScore is int && data.irtScore >= 0 && data.irtScore <= 1000 &&
             data.correctCount is int && data.correctCount >= 0 && data.correctCount <= 200 &&
             data.totalQuestions is int && data.totalQuestions >= 1 && data.totalQuestions <= 200 &&
             data.durationSeconds is int && data.durationSeconds >= 0 && data.durationSeconds <= 10000 &&
             isBoundedStringList(data.weakSubtopics, 20) &&
             isBoundedStringList(data.strongSubtopics, 20) &&
             data.aiAnalysisSummary is string && data.aiAnalysisSummary.size() <= 5000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidSavedCustomQuestion(data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128 &&
             data.subjectId is string && data.subjectId.size() >= 1 && data.subjectId.size() <= 64 &&
             data.subtopic is string && data.subtopic.size() >= 1 && data.subtopic.size() <= 100 &&
             data.difficulty is int && data.difficulty >= 1 && data.difficulty <= 3 &&
             data.questionType is string && (data.questionType == 'SINGLE_CHOICE' || data.questionType == 'MCMA' || data.questionType == 'TRUE_FALSE_MATRIX') &&
             data.stem is string && data.stem.size() >= 1 && data.stem.size() <= 3000 &&
             isBoundedStringList(data.options, 10) && data.options.size() >= 2 &&
             data.correctAnswerCode is string && data.correctAnswerCode.size() >= 1 && data.correctAnswerCode.size() <= 200 &&
             data.explanation is string && data.explanation.size() >= 1 && data.explanation.size() <= 4000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'xp', 'streakDays', 'hearts', 'gems',
                         'totalExamsCompleted', 'totalRemedialsCompleted', 'weakSubtopics',
                         'masteredUnits', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'xp', 'streakDays', 'hearts', 'gems',
                         'totalExamsCompleted', 'totalRemedialsCompleted', 'weakSubtopics',
                         'masteredUnits', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'xp', 'streakDays', 'hearts', 'gems',
                         'totalExamsCompleted', 'totalRemedialsCompleted', 'weakSubtopics',
                         'masteredUnits', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

      match /attempts/{attemptId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(attemptId) && request.auth.uid == userId;
        allow list: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(attemptId) &&
                         request.auth.uid == userId &&
                         incoming().keys().hasAll([
                           'userId', 'subjectId', 'subjectName', 'mode', 'irtScore',
                           'correctCount', 'totalQuestions', 'durationSeconds',
                           'weakSubtopics', 'strongSubtopics', 'aiAnalysisSummary',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'subjectId', 'subjectName', 'mode', 'irtScore',
                           'correctCount', 'totalQuestions', 'durationSeconds',
                           'weakSubtopics', 'strongSubtopics', 'aiAnalysisSummary',
                           'createdAt', 'updatedAt'
                         ]) &&
                         isValidExamAttempt(incoming());

        allow update: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(attemptId) &&
                         request.auth.uid == userId &&
                         isValidExamAttempt(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'aiAnalysisSummary', 'updatedAt'
                         ]);

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(attemptId) && request.auth.uid == userId;
      }

      match /custom_questions/{questionId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(questionId) && request.auth.uid == userId;
        allow list: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(questionId) &&
                         request.auth.uid == userId &&
                         incoming().keys().hasAll([
                           'userId', 'subjectId', 'subtopic', 'difficulty', 'questionType',
                           'stem', 'options', 'correctAnswerCode', 'explanation',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'subjectId', 'subtopic', 'difficulty', 'questionType',
                           'stem', 'options', 'correctAnswerCode', 'explanation',
                           'createdAt', 'updatedAt'
                         ]) &&
                         isValidSavedCustomQuestion(incoming());

        allow update: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(questionId) &&
                         request.auth.uid == userId &&
                         isValidSavedCustomQuestion(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'explanation', 'updatedAt'
                         ]);

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(questionId) && request.auth.uid == userId;
      }
    }
  }
}
